{
  "name": "trocaticket-front",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src public/data package.json index.html README.md",
    "format:check": "prettier --check src public/data package.json index.html README.md",
    "build:forum": "npm --prefix forum run build",
    "predev": "npm run build:forum",
    "prebuild": "npm run build:forum"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.8",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
