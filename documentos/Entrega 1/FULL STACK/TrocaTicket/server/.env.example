DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=
PORT=3000

# Opcionais (sessão de login)
# Endereços do site aceitos pela API, separados por vírgula.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Duração da sessão em horas (padrão 8).
# SESSION_HOURS=8
# Use true quando a API estiver atrás de HTTPS.
# COOKIE_SECURE=false
