/* Event creation: simplified, grouped and responsive form */
.event-editor-page > .page-title { margin-bottom: 12px; }
.event-editor-hint {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 18px;
  padding: 10px 13px;
  border: 1px solid #dcefe7;
  border-radius: 10px;
  background: #f5fbf8;
  color: #456b5c;
  font-size: 12px;
}
.event-editor-hint span { color: #13845d; font-weight: 800; }
.event-editor-layout { grid-template-columns: minmax(0, 1.55fr) minmax(260px, .85fr); gap: 30px; padding: 4px; }
.event-editor-main, .event-editor-side { min-width: 0; }
.event-form-section { min-width: 0; }
.event-form-section + .event-form-section { margin-top: 26px; padding-top: 24px; border-top: 1px solid #edf1f6; }
.event-section-heading { display: flex; align-items: flex-start; gap: 11px; margin-bottom: 20px; }
.event-section-number { display: inline-flex; flex: 0 0 28px; width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 9px; background: #edf3ff; color: #285ee8; font-size: 12px; font-weight: 750; }
.event-section-heading h2 { margin: 2px 0 4px; font-size: 15px; line-height: 1.35; color: #17233a; }
.event-section-heading p { margin: 0; color: #75839a; font-size: 12px; line-height: 1.5; }
.event-editor-layout .field { margin-bottom: 17px; }
.event-editor-layout .field label { margin-bottom: 7px; }
.event-editor-layout .form-grid { gap: 0 14px; }
.event-date-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.event-field-note { margin: -2px 0 0; color: #78869c; font-size: 11px; line-height: 1.5; }
.event-description-section textarea { resize: vertical; min-height: 110px; }
.event-character-count { margin-top: -9px; text-align: right; color: #8996aa; font-size: 11px; }
.event-cover-upload { position: relative; padding: 10px; background: #fafcff; }
.event-cover-upload img { height: 190px; margin-bottom: 12px; background: #edf1f6; }
.event-cover-upload span { display: block; font-weight: 650; }
.event-cover-upload small { display: block; margin-top: 5px; color: #8492a8; font-size: 11px; }
.event-remove-cover { width: 100%; margin-top: 10px; font-size: 12px; }
.event-next-step-card { margin-top: 24px; padding: 17px; border: 1px solid #e0e8f4; border-radius: 12px; background: #f7f9fd; }
.event-next-step-icon { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; margin-bottom: 10px; border-radius: 9px; background: #e6eeff; color: #285ee8; font-size: 18px; }
.event-next-step-card h3 { margin: 0 0 7px; font-size: 13px; color: #1d2b44; }
.event-next-step-card p { margin: 0; color: #6f7e95; font-size: 12px; line-height: 1.6; }
.event-editor-footer { margin-top: 24px; }
@media (max-width: 850px) {
  .event-editor-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .event-editor-side { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: 16px; align-items: start; }
  .event-editor-side .event-form-section + .event-next-step-card { margin-top: 0; }
}
@media (max-width: 560px) {
  .event-editor-layout { padding: 0; }
  .event-editor-side { display: block; }
  .event-date-grid { grid-template-columns: minmax(0, 1fr); }
  .event-editor-footer { display: grid; grid-template-columns: 1fr; }
  .event-editor-footer .button { width: 100%; }
  .event-cover-upload img { height: 170px; }
}

