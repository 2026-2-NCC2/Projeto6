import React, { useState } from 'react';
import { Link, useNavigate, useParams } from 'react-router';
import { useStore } from '../../context/Store';
import { Modal, NotFound, PageTitle, Panel, dateLabel, downloadCSV, money } from '../../components/UI';
import { supplierOpportunities as opportunities, quoteTotal } from '../../data/supplier';
import { FormTextArea, RadioCards } from '../../components/supplier/FormControls';
import { BriefingPanel, DemandCard, OrganizerCard, QuoteFooter, QuoteItemsTable } from '../../components/supplier/QuoteParts';
import { Callout, Chip, LabeledSelect, SearchInput, Tag } from '../../components/supplier/common';
import Icon from '../../components/supplier/Icon';

const PAYMENTS = ['50% sinal + 50% D+10', 'Faturamento 28 DDL'];
const CRITERIA = [
  'Certidões negativas e documentos fiscais da empresa em dia.',
  'Apólice de seguro de responsabilidade civil vigente para o evento.',
  'Equipe com treinamento e certificações exigidas no memorial descritivo.',
  'Laudos e ART dos equipamentos e estruturas que serão instalados.',
];
const normalize = (text) => text.toLocaleLowerCase('pt-BR').normalize('NFD').replace(/\p{Diacritic}/gu, '');

export default function SupplierQuote() {
  const { id } = useParams();
  const { data, update, notify } = useStore();
  const navigate = useNavigate();
  const event = opportunities.find((e) => e.id === id);
  const items = event?.quote.items ?? [];
  const draft = data.proposals.find((p) => p.eventId === id && p.status === 'Rascunho');

  const [prices, setPrices] = useState(() => draft?.prices || items.map((item) => item.offer));
  const [note, setNote] = useState(draft?.note || '');
  const [payment, setPayment] = useState(draft?.payment || PAYMENTS[0]);
  const [invalid, setInvalid] = useState([]);
  const [query, setQuery] = useState('');
  const [category, setCategory] = useState('Todas');
  const [modal, setModal] = useState(null); // 'criteria' | doc | 'docs'

  if (!event) return <NotFound title="Cotação não encontrada" />;

  const { quote } = event;
  const locked = quote.window.state === 'submitted';
  const total = quoteTotal(items, prices);
  const ceiling = items.reduce((sum, item) => sum + item.qty * item.ref, 0);
  const categories = ['Todas', ...new Set(opportunities.map((e) => e.category))];
  const demands = opportunities.filter(
    (e) =>
      normalize(`${e.title} ${e.subtitle} ${e.organizer}`).includes(normalize(query.trim())) &&
      (category === 'Todas' || e.category === category),
  );
  const openCount = opportunities.filter((e) => e.quote.window.state !== 'submitted').length;
  const closingCount = opportunities.filter((e) => e.quote.window.state === 'closing').length;

  function submit(status) {
    const bad = prices.map((v, i) => (Number.isFinite(Number(v)) && Number(v) > 0 ? -1 : i)).filter((i) => i >= 0);
    setInvalid(bad);
    if (bad.length) {
      document.getElementById(`quote-price-${bad[0]}`)?.focus();
      return;
    }
    const proposal = {
      id: draft?.id || `PRP-${event.date.slice(0, 4)}-${String(Date.now()).slice(-4)}`,
      eventId: id,
      title: `${event.title} — ${event.subtitle}`,
      total,
      status,
      date: new Date().toISOString().slice(0, 10),
      eventDate: event.date,
      location: event.location,
      organizer: event.organizer,
      category: event.category,
      description: `${items.length} itens cotados: ${items.map((item) => item.name.split(' (')[0]).join(', ')}`,
      payment,
      prices: prices.map(Number),
      items: items.map((item, i) => ({ name: item.name, qty: item.qty, unit: item.unit, price: Number(prices[i]) })),
      note,
    };
    update('proposals', (old) => (draft ? old.map((p) => (p.id === draft.id ? proposal : p)) : [proposal, ...old]));
    notify(status === 'Rascunho' ? 'Rascunho da proposta salvo.' : 'Proposta enviada para análise na demonstração.');
    navigate('/fornecedor/propostas');
  }

  function openDoc(doc) {
    if (!doc) {
      setModal('docs');
      return;
    }
    notify(`O download de “${doc.name}” ficará disponível quando o backend for conectado.`);
  }

  return (
    <div className="workspace sp-page">
      <PageTitle
        title={
          <span className="sp-title-with-chip">
            Eventos
            <Chip tone="blue">{openCount} abertos para cotação</Chip>
            {closingCount > 0 && <Chip tone="amber">{closingCount} próximo do prazo</Chip>}
          </span>
        }
        subtitle="Selecione uma demanda no menu lateral para visualizar os editais e submeter sua proposta técnica e comercial."
      >
        <SearchInput value={query} onChange={setQuery} placeholder="Buscar evento ou organizadora…" label="Buscar evento ou organizadora" />
        <LabeledSelect label="Categoria:" value={category} onChange={setCategory} options={categories} />
      </PageTitle>

      <div className="sp-quote-layout">
        <aside className="sp-quote-side">
          <OrganizerCard name={event.organizer} city={quote.organizer.city} reliability={quote.organizer.reliability} />
          <div className="sp-side-title">
            <small>DEMANDA EM CONCORRÊNCIA</small>
            <span>Total: {demands.length}</span>
          </div>
          {demands.map((demand) => (
            <DemandCard key={demand.id} event={demand} active={demand.id === id} />
          ))}
          {!demands.length && <p className="muted sp-side-empty">Nenhuma demanda com esses filtros.</p>}
          <BriefingPanel docs={quote.docs} onOpen={openDoc} />
        </aside>

        <Panel className="sp-quote-main">
          <div className="sp-quote-top">
            <div>
              <div className="sp-quote-tags">
                <Tag tone="blue">COTAÇÃO ATIVA Nº {quote.code}</Tag>
                <span>Lote: {quote.lot}</span>
              </div>
              <h1>
                {event.title} — {event.subtitle}
              </h1>
              <p className="sp-quote-meta">
                <span>
                  <Icon name="pin" size={14} /> {quote.venue} · {event.location}
                </span>
                <span>
                  <Icon name="user" size={14} /> Público estimado: {quote.audience}
                </span>
              </p>
            </div>
            <div className={`sp-deadline ${quote.window.state}`}>
              <small>RECEBIMENTO DE PROPOSTAS</small>
              <strong>{quote.closesIn}</strong>
              <span>{quote.closesAt}</span>
            </div>
          </div>

          <p className="sp-scope-text">
            <strong>Escopo resumido:</strong> {quote.scope}
          </p>

          {locked && (
            <Callout
              tone="blue"
              icon="check"
              title={`Proposta enviada em ${event.proposal.sentAt}`}
              action={<span className="sp-protocol">Protocolo {event.proposal.protocol}</span>}
            >
              Os valores abaixo estão bloqueados enquanto a proposta é analisada.
            </Callout>
          )}

          <div className="sp-section-head">
            <h2>
              Itens requisitados para cotação <Chip>{items.length} itens</Chip>
            </h2>
            <button type="button" className="sp-link-button" onClick={() => setModal('criteria')}>
              Revisar critérios técnicos de homologação <Icon name="arrow-right" size={13} />
            </button>
          </div>

          <QuoteItemsTable
            items={items}
            prices={prices}
            invalid={invalid}
            disabled={locked}
            onPrice={(i, value) => setPrices((old) => old.map((v, j) => (j === i ? value : v)))}
          />
          {invalid.length > 0 && (
            <p role="alert" className="field-error">
              Informe um valor maior que zero para todos os itens.
            </p>
          )}

          <div className="sp-quote-extras">
            <FormTextArea
              label="Observações & diferenciais da fornecedora"
              name="quote-note"
              rows={4}
              disabled={locked}
              placeholder="Ex.: informar tempo de montagem, frota própria de caminhões refrigerados, certificados ISO…"
              value={note}
              onChange={setNote}
            />
            <div>
              <RadioCards legend="Condição de faturamento proposta" name="payment" options={PAYMENTS} value={payment} onChange={locked ? () => {} : setPayment} />
              <small className="sp-hint">
                * Conforme edital, o pagamento é garantido via custódia TrocaTicket Pay.
              </small>
            </div>
          </div>

          <QuoteFooter total={total} withinCeiling={total <= ceiling}>
            {locked ? (
              <Link className="button blue-button" to="/fornecedor/propostas">
                Acompanhar proposta <Icon name="arrow-right" size={14} />
              </Link>
            ) : (
              <>
                <button type="button" className="button sp-ghost-light" onClick={() => submit('Rascunho')}>
                  Salvar rascunho
                </button>
                <button type="button" className="button blue-button" onClick={() => submit('Em análise')}>
                  Enviar proposta comercial <Icon name="arrow-right" size={14} />
                </button>
              </>
            )}
          </QuoteFooter>
        </Panel>
      </div>

      {modal === 'criteria' && (
        <Modal title="Critérios técnicos de homologação" onClose={() => setModal(null)}>
          <ul className="sp-criteria">
            {CRITERIA.map((item) => (
              <li key={item}>
                <Icon name="check" size={14} /> {item}
              </li>
            ))}
          </ul>
          <p className="muted">Critérios de demonstração. Os critérios reais virão do edital de cada evento.</p>
        </Modal>
      )}
      {modal === 'docs' && (
        <Modal title="Briefing do evento" onClose={() => setModal(null)}>
          <p>{quote.scope}</p>
          <button
            className="button outline"
            onClick={() =>
              downloadCSV('briefing.csv', [
                [event.title],
                ['Item', 'Quantidade', 'Unidade', 'Valor sugerido'],
                ...items.map((item) => [item.name, item.qty, item.unit, item.ref]),
              ])
            }
          >
            ↓ Baixar briefing (CSV)
          </button>
          <p className="muted">
            Teto sugerido da cotação: <strong>{money(ceiling)}</strong> · evento em {dateLabel(event.date)}
          </p>
        </Modal>
      )}
    </div>
  );
}
</file>

<file path="src/pages/Account.jsx">
import React, { useState } from 'react';
import { Link, useNavigate, useSearchParams } from 'react-router';
import { useStore } from '../context/Store';
import { destinations, roleNames } from '../data/demo';
import { Field, Tabs } from '../components/UI';

export default function Account({ login = false }) {
  const navigate = useNavigate();

  const [params] = useSearchParams();
  const [profile, setProfile] = useState(['comprador', 'organizador', 'fornecedor'].includes(params.get('perfil')) ? params.get('perfil') : 'comprador');
  const [errors, setErrors] = useState({});
  const [busy, setBusy] = useState(false);
  const [show, setShow] = useState(false);
  const { chooseRole, notify } = useStore();

  async function submit(event) {

    event.preventDefault();

    const data = Object.fromEntries(new FormData(event.currentTarget));
    const next = {};

    if (!login && data.name.trim().length < 2) {
      next.name = "Informe seu nome completo.";
    }

    if (!login && ![11, 14].includes(data.document.replace(/\D/g, '').length)) {
      next.document = 'Use 11 dígitos para CPF ou 14 para CNPJ (fictício).';
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
      next.email = 'Informe um e-mail válido.';
    }

    if (data.password.length < 8) {
      next.password = 'Use pelo menos 8 caracteres.';
    }
      
    if (!login && data.confirm !== data.password) {
      next.confirm = 'As senhas não conferem.';
    }

    setErrors(next);
    
    if (Object.keys(next).length) {
      document.getElementById(Object.keys(next)[0])?.focus();
      return;
    }
    
    setBusy(true);
   
    await new Promise((resolve) => setTimeout(resolve, 450));
    
    chooseRole(profile);
    
    notify(
      login ? 'Acesso de demonstração iniciado.' : 'Cadastro validado. Bem-vindo à demonstração!',
    );
    
    navigate(login ? '/perfis' : destinations[profile]);
  }

  return (
    <section className="auth-page">
      <div className="auth-card">
        <span className="auth-symbol">♙</span>
        <h1>{login ? 'Acesse sua Conta' : 'Crie sua Conta'}</h1>
        <div className="tabs auth-tabs">
          <Link className={login ? 'active' : ''} to="/entrar">
            Entrar
          </Link>
          <Link className={!login ? 'active' : ''} to="/cadastro">
            Criar Conta
          </Link>
        </div>
        {!login && (
          <Tabs
            options={['Participante', 'Organizador', 'Fornecedor']}
            value={roleNames[profile]}
            onChange={(value) =>
              setProfile(Object.keys(roleNames).find((key) => roleNames[key] === value))
            }
          />
        )}
        <form noValidate onSubmit={submit}>
          {!login && (
            <>
              <Field
                label="Nome completo"
                name="name"
                autoComplete="name"
                placeholder="João da Silva"
                error={errors.name}
              />
              <Field
                label={profile === 'comprador' ? 'CPF' : 'CPF / CNPJ'}
                name="document"
                placeholder={profile === 'comprador' ? '000.000.000-00' : '000.000.000-00 ou 00.000.000/0000-00'}
                error={errors.document}
              />
            </>
          )}
          <Field
            label="E-mail"
            name="email"
            type="email"
            autoComplete="email"
            placeholder="exemplo@email.com"
            error={errors.email}
          />
          <Field
            label="Senha"
            name="password"
            type={show ? 'text' : 'password'}
            autoComplete={login ? 'current-password' : 'new-password'}
            placeholder="Mínimo de 8 caracteres"
            error={errors.password}
          />
          {!login && (
            <Field
              label="Confirme sua senha"
              name="confirm"
              type={show ? 'text' : 'password'}
              autoComplete="new-password"
              error={errors.confirm}
            />
          )}
          <div className="form-options">
            <label>
              <input type="checkbox" checked={show} onChange={(e) => setShow(e.target.checked)} />{' '}
              Mostrar senha
            </label>
            {login && <Link to="/recuperar">Esqueceu sua senha?</Link>}
          </div>
          <button className={`button ${login ? 'blue-button' : 'dark'}`} disabled={busy}>
            {busy ? 'Validando…' : login ? 'Entrar na plataforma' : 'Cadastrar'}
          </button>
        </form>
        <p className="auth-note">
          Demonstração: use dados fictícios. Senhas e documentos não são armazenados.
        </p>
        <div className="divider">OU EXPLORE SEM CADASTRO</div>
        <Link className="button outline full" to="/perfis">
          Escolher perfil de demonstração →
        </Link>
      </div>
    </section>
  );
}

export function Profiles() {
  const { chooseRole } = useStore();
  const navigate = useNavigate();
  return (
    <section className="auth-page profile-selection">
      <div className="section-heading">
        <p className="eyebrow purple">Uma plataforma, muitas possibilidades</p>
        <h1>Como você quer explorar?</h1>
        <p>Escolha um perfil para conhecer os fluxos da plataforma.</p>
      </div>
      <div className="role-grid">
        {Object.entries(roleNames).map(([id, name], i) => (
          <button
            className="role-card"
            key={id}
            onClick={() => {
              chooseRole(id);
              navigate(destinations[id]);
            }}
          >
            <span className="role-symbol">{['♧', '⚑', '▣', '◇'][i]}</span>
            <h2>{name}</h2>
            <p>
              {
                [
                  'Descubra eventos, salve favoritos e simule seus ingressos.',
                  'Crie eventos, conecte fornecedores e consolide custos.',
                  'Gerencie seu catálogo e envie propostas comerciais.',
                  'Acompanhe relatórios e faça a moderação de cadastros.',
                ][i]
              }
            </p>
            <strong>Acessar área →</strong>
          </button>
        ))}
      </div>
      <Link className="text-link" to="/">
        ← Voltar ao início
      </Link>
    </section>
  );
}
export function Recover() {
  const [done, setDone] = useState(false);
  return (
    <section className="auth-page">
      <div className="auth-card">
        <h1>Recuperar acesso</h1>
        {done ? (
          <p role="status">
            Solicitação simulada. Nenhum e-mail foi enviado; você pode entrar com qualquer e-mail
            válido e senha de 8 caracteres na demonstração.
          </p>
        ) : (
          <form
            onSubmit={(e) => {
              e.preventDefault();
              setDone(true);
            }}
          >
            <Field label="E-mail da conta" name="recover-email" type="email" required />
            <button className="button blue-button">Simular recuperação</button>
          </form>
        )}
        <Link className="text-link" to="/entrar">
          Voltar para entrar
        </Link>
      </div>
    </section>
  );
}
</file>

<file path="src/pages/Admin.jsx">
import React, { useState } from 'react';
import { Link } from 'react-router';
import { opportunities } from '../data/demo';
import { STATUS_TONE, eventReports } from '../data/reports';
import { Badge, DownloadButton, Empty, Panel, dateLabel, money } from '../components/UI';
import Pagination from '../components/Pagination';
import { Icon } from '../components/Icons';
import EventCard from '../components/EventCard';

// Tabela de lotes (dados de demonstração).
const lots = [
  ['LT-2032-TM1', 'tim-maia', 'Pista Premium', 5000, 3420, 'Aprovado'],
  ['LT-2031-LP2', 'lil-peep', 'Camarote Gold', 2500, 1890, 'Em revisão'],
  ['LT-2028-MJ3', 'michael', 'Arquibancada Geral', 12000, 8950, 'Pendente'],
  ['LT-2032-TM2', 'tim-maia', 'Cadeira Superior', 3800, 2110, 'Aprovado'],
  ['LT-2031-LP3', 'lil-peep', 'Pista Comum', 4200, 3010, 'Aprovado'],
  ['LT-2028-MJ4', 'michael', 'VIP Lounge', 800, 620, 'Aprovado'],
];
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const SORTS = {
  Data: (a, b) => a.date.localeCompare(b.date),
  Nome: (a, b) => a.title.localeCompare(b.title),
  Vendas: (a, b) => b.report.sold - a.report.sold,
};
const fmt = (n) => n.toLocaleString('pt-BR');
const asEvent = (event) => ({ ...event, report: eventReports[event.id] });

export default function Admin() {
  const [query, setQuery] = useState('');
  const [status, setStatus] = useState('Todos');
  const [sort, setSort] = useState('Data');
  const [more, setMore] = useState(false);
  const [minOccupancy, setMinOccupancy] = useState(0);
  const [page, setPage] = useState(1);
  const [updatedAt] = useState(() =>
    new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }),
  );

  const all = opportunities.map(asEvent);
  const text = query.trim().toLowerCase();
  const events = all
    .filter(
      (e) =>
        `${e.title} ${e.subtitle} ${e.organizer}`.toLowerCase().includes(text) &&
        (status === 'Todos' || e.report.status === status) &&
        e.report.occupancy >= minOccupancy,
    )
    .sort(SORTS[sort]);
  const active = all.filter((e) => e.report.status !== 'Em auditoria').length;
  const auditing = all.length - active;

  const filteredLots = lots.filter((l) =>
    `${l[0]} ${opportunities.find((e) => e.id === l[1]).title}`.toLowerCase().includes(text),
  );
  const pages = Math.max(1, Math.ceil(filteredLots.length / 4));
  const current = Math.min(page, pages);

  return (
    <div className="workspace admin-home">
      <section className="ah-search" aria-label="Pesquisa de eventos">
        <div className="ah-search-row">
          <label className="search-box wide">
            <Icon name="search" size={18} />
            <input
              aria-label="Buscar eventos"
              placeholder="Buscar por evento, artista ou código..."
              value={query}
              onChange={(e) => {
                setQuery(e.target.value);
                setPage(1);
              }}
            />
          </label>
          <div className="ah-filters">
            <label>
              Status:
              <select value={status} onChange={(e) => setStatus(e.target.value)}>
                <option value="Todos">Todos os Eventos ({all.length})</option>
                {Object.keys(STATUS_TONE).map((s) => (
                  <option key={s}>{s}</option>
                ))}
              </select>
            </label>
            <label>
              Ordenar:
              <select value={sort} onChange={(e) => setSort(e.target.value)}>
                {Object.keys(SORTS).map((s) => (
                  <option key={s} value={s}>
                    {s === 'Data' ? 'Data do Evento' : s === 'Nome' ? 'Nome' : 'Mais vendidos'}
                  </option>
                ))}
              </select>
            </label>
            <button
              type="button"
              className="button soft"
              aria-expanded={more}
              onClick={() => setMore(!more)}
            >
              <Icon name="filter" size={16} /> Mais Filtros
            </button>
          </div>
        </div>
        {more && (
          <div className="ah-more">
            <label>
              Ocupação mínima:
              <select
                value={minOccupancy}
                onChange={(e) => setMinOccupancy(Number(e.target.value))}
              >
                <option value={0}>Qualquer</option>
                <option value={80}>A partir de 80%</option>
                <option value={90}>A partir de 90%</option>
              </select>
            </label>
            <button
              type="button"
              className="text-link plain-button"
              onClick={() => {
                setStatus('Todos');
                setMinOccupancy(0);
                setQuery('');
              }}
            >
              Limpar filtros
            </button>
          </div>
        )}
        <div className="ah-summary">
          <span>
            Eventos em destaque: <strong>{active} ativos</strong>
          </span>
          <i aria-hidden="true" />
          <span>
            Relatórios em auditoria:{' '}
            <strong className="amber">
              {auditing} pendente{auditing === 1 ? '' : 's'}
            </strong>
          </span>
          <span className="ah-updated">Última atualização: Hoje às {updatedAt}</span>
        </div>
      </section>

      <div className="ah-heading">
        <h2>Grade de Eventos</h2>
        <span className="ah-count">
          {events.length} {events.length === 1 ? 'Evento' : 'Eventos'}
        </span>
      </div>
      <p className="ah-lead">
        Selecione um evento para acessar relatórios gerenciais e auditorias.
      </p>

      <div className="ah-grid">
        {events.map((event, i) => {
          const r = event.report;
          return (
            <EventCard
              key={event.id}
              event={event}
              variant="admin"
              metrics={{
                tag: `EVENTO ${ROMAN[i]}`,
                status: r.status,
                statusTone: STATUS_TONE[r.status],
                city: r.city.split(',')[0],
                rows: [
                  { label: 'Organizador', value: event.organizer },
                  { label: 'Ingressos vendidos', value: fmt(r.sold), tone: 'ah-pill' },
                  { label: 'Ocupação', value: `${String(r.occupancy).replace('.', ',')}%`, tone: 'green' },
                  { label: 'Faturamento bruto', value: money(r.revenue) },
                ],
                highlightText: (
                  <>
                    <Icon name="chart" size={18} />
                    <span>
                      {fmt(r.exchanges)} trocas · {r.conversion} de conversão
                    </span>
                    <Link to={`/admin/relatorios/${event.id}`}>Ver painel</Link>
                  </>
                ),
              }}
              actions={
                <Link className="ah-cta" to={`/admin/relatorios/${event.id}`}>
                  Visão e Relatórios ↗
                </Link>
              }
            />
          );
        })}
      </div>
      {!events.length && <Empty>Nenhum evento corresponde aos filtros selecionados.</Empty>}

      <Panel
        className="ah-table"
        title="Lista Consolidada de Relatórios Recentes e Lotes"
        subtitle="Histórico de validação e transferências demonstrativas."
        action={
          <DownloadButton
            name="relatorio-geral.csv"
            rows={[['Lote', 'Evento', 'Setor', 'Emitidos', 'Trocas', 'Status'], ...lots]}
          />
        }
      >
        <div className="table-wrap">
          <table>
            <thead>
              <tr>
                <th>ID do lote</th>
                <th>Evento / artista</th>
                <th>Data prevista</th>
                <th>Emitidos</th>
                <th>Trocas concluídas</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              {filteredLots.slice((current - 1) * 4, current * 4).map((l) => {
                const event = opportunities.find((e) => e.id === l[1]);
                return (
                  <tr key={l[0]}>
                    <td>
                      <code>{l[0]}</code>
                    </td>
                    <td>
                      <strong>{event.title}</strong>
                      <small>{l[2]}</small>
                    </td>
                    <td>{dateLabel(event.date)}</td>
                    <td>{fmt(l[3])}</td>
                    <td className="green-text">{fmt(l[4])}</td>
                    <td>
                      <Badge>{l[5]}</Badge>
                    </td>
                    <td>
                      <Link className="text-link" to={`/admin/relatorios/${event.id}`}>
                        Ver →
                      </Link>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {!filteredLots.length && <Empty />}
        <Pagination
          page={current}
          pageSize={4}
          total={filteredLots.length}
          onPage={setPage}
          summary={(from, to, total) => `${total} registros · página ${current} de ${pages}`}
        />
      </Panel>
    </div>
  );
}
</file>

