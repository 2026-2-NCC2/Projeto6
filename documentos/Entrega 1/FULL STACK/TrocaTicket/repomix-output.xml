<file path="src/components/supplier/InventoryTable.jsx">
import React from 'react';
import { money } from '../UI';
import { kindOf, marginOf, skuOf, statusView } from '../../utils/inventory';
import Icon, { categoryIcon } from './Icon';
import { StatusPill } from './common';

const CATEGORY_TONES = {
  'Bebidas & Bar': 'blue',
  'Iluminação': 'amber',
  'Estrutura & Palco': 'purple',
  'Alimentação & Buffet': 'green',
  'Som & Acústica': 'pink',
  'Segurança & Apoio': 'gray',
};

/*
 * Tabela de itens do inventário com seleção de linha.
 *  - selectedId: item exibido no painel de detalhes
 *  - onSelect(id), onEdit(item), onDuplicate(item)
 */
export default function InventoryTable({ items, selectedId, onSelect, onEdit, onDuplicate }) {
  return (
    <div className="table-wrap sp-inventory-table">
      <table>
        <thead>
          <tr>
            <th>Item & código SKU</th>
            <th>Categoria & tipo</th>
            <th>Unidade</th>
            <th className="end">Valor referência</th>
            <th>Status</th>
            <th className="end">Ações</th>
          </tr>
        </thead>
        <tbody>
          {items.map((item) => {
            const selected = item.id === selectedId;
            const view = statusView(item);
            const margin = marginOf(item);
            return (
              <tr key={item.id} className={selected ? 'selected' : ''} onClick={() => onSelect(item.id)}>
                <td>
                  <div className="sp-item-cell">
                    <span className={`sp-item-icon ${CATEGORY_TONES[item.category] || 'blue'}`}>
                      <Icon name={categoryIcon[item.category] || 'box'} size={17} />
                    </span>
                    <div>
                      <button
                        type="button"
                        className="sp-row-select"
                        aria-current={selected ? 'true' : undefined}
                        onClick={(event) => {
                          event.stopPropagation();
                          onSelect(item.id);
                        }}
                      >
                        {item.name}
                      </button>
                      <code>#{skuOf(item)}</code>
                    </div>
                  </div>
                </td>
                <td>
                  <strong>{item.category}</strong>
                  <small>{item.type || 'Item de catálogo'}</small>
                </td>
                <td>
                  <span className="sp-unit">{item.unit}</span>
                </td>
                <td className="end">
                  <strong>{money(item.price)}</strong>
                  {margin !== null && <small className={margin >= 0 ? 'ok' : 'bad'}>Margem líq. {margin}%</small>}
                </td>
                <td>
                  <StatusPill tone={view.tone}>{view.label}</StatusPill>
                </td>
                <td>
                  <div className="sp-row-actions">
                    <button
                      type="button"
                      className={`sp-icon-button ${selected ? 'active' : ''}`}
                      aria-label={`Ver detalhes de ${item.name}`}
                      aria-pressed={selected}
                      onClick={(event) => {
                        event.stopPropagation();
                        onSelect(item.id);
                      }}
                    >
                      <Icon name="eye" size={15} />
                    </button>
                    <button
                      type="button"
                      className="sp-icon-button"
                      aria-label={`Editar ${item.name}`}
                      onClick={(event) => {
                        event.stopPropagation();
                        onEdit(item);
                      }}
                    >
                      <Icon name="pencil" size={15} />
                    </button>
                    <button
                      type="button"
                      className="sp-icon-button"
                      aria-label={`Duplicar ${item.name}`}
                      onClick={(event) => {
                        event.stopPropagation();
                        onDuplicate(item);
                      }}
                    >
                      <Icon name="copy" size={15} />
                    </button>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}
</file>

<file path="src/components/supplier/ItemDetail.jsx">
import React from 'react';
import { Link } from 'react-router';
import { money } from '../UI';
import { marginOf, skuOf, specsOf } from '../../utils/inventory';
import Icon from './Icon';
import { Tag } from './common';

/*
 * Painel com as informações do item selecionado na tabela.
 *  - onEdit(item) / onToggle(item): editar cadastro e ativar/desativar
 */
export default function ItemDetail({ item, onEdit, onToggle }) {
  const specs = specsOf(item);
  const usage = item.usage || [];
  const margin = marginOf(item);
  const cost = Number(item.cost) || 0;
  const price = Number(item.price) || 0;
  const costPercent = price && cost ? Math.min(100, Math.round((cost / price) * 100)) : 0;
  const inactive = item.status === 'Inativo';
  return (
    <section className="sp-item-detail" aria-label={`Detalhes de ${item.name}`}>
      <div className="sp-item-hero">
        <div className="sp-item-hero-top">
          <span className="sp-hero-chip">ITEM EM COMPOSIÇÃO</span>
          <Icon name="lock" size={15} />
        </div>
        <h2>{item.name}</h2>
        {item.version && <p>{item.version}</p>}
        <div className="sp-item-hero-foot">
          <div>
            <small>SKU HOMOLOGADO</small>
            <code>#{skuOf(item)}</code>
          </div>
          <div className="end">
            <small>PREÇO BASE SUGERIDO</small>
            <strong>{money(item.price)}</strong>
          </div>
        </div>
      </div>

      <div className="sp-item-body">
        <h3>ESPECIFICAÇÕES TÉCNICAS</h3>
        <dl className="sp-specs">
          {specs.map(([label, value]) => (
            <div key={label}>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>

        <div className="sp-usage-head">
          <h3>UTILIZAÇÃO RECENTE EM EVENTOS</h3>
          {usage.length > 0 && <small>{usage.length} aceitos</small>}
        </div>
        {usage.length > 0 ? (
          <ul className="sp-usage">
            {usage.map((entry) => (
              <li key={entry.event}>
                <div>
                  <strong>{entry.event}</strong>
                  <small>{entry.detail}</small>
                </div>
                <Tag tone={entry.tone}>{entry.tag}</Tag>
              </li>
            ))}
          </ul>
        ) : (
          <p className="sp-hint">Este item ainda não foi utilizado em propostas aceitas.</p>
        )}

        {cost > 0 && (
          <div className="sp-cost">
            <div className="sp-cost-head">
              <span>Custo direto operacional:</span>
              <strong>{money(cost)}</strong>
            </div>
            <div
              className="sp-cost-bar"
              role="img"
              aria-label={`Custo e desgaste ${costPercent}%, margem bruta ${margin}%`}
            >
              <i style={{ width: `${costPercent}%` }} />
            </div>
            <div className="sp-cost-legend">
              <span>Custo fixo & desgaste ({costPercent}%)</span>
              <span className="ok">
                Margem bruta ({margin}% = {money(price - cost)})
              </span>
            </div>
          </div>
        )}

        <Link className="button blue-button full" to="/fornecedor">
          <Icon name="plus" size={15} /> Simular em nova proposta de evento
        </Link>
        <div className="sp-detail-actions">
          <button type="button" className="button outline" onClick={() => onEdit(item)}>
            Editar cadastro
          </button>
          <button type="button" className={`button ${inactive ? 'outline' : 'danger-outline'}`} onClick={() => onToggle(item)}>
            {inactive ? 'Reativar item' : 'Desativar item'}
          </button>
        </div>
      </div>
    </section>
  );
}
</file>

<file path="src/components/supplier/ItemFormModal.jsx">
import React, { useState } from 'react';
import { Modal } from '../UI';
import { inventoryStatuses, inventoryTypes, supplierCategories } from '../../data/supplier';
import { specsToText, textToSpecs } from '../../utils/inventory';
import { FormInput, FormSelect, FormTextArea } from './FormControls';

/* Formulário (modal) para criar ou editar um item do catálogo. onSave recebe o item já normalizado. */
export default function ItemFormModal({ item, onSave, onClose }) {
  const [kind, subtype = ''] = (item.type || 'Produto').split(' / ');
  const [form, setForm] = useState({
    name: item.name || '',
    version: item.version || '',
    category: item.category || supplierCategories[0],
    kind: inventoryTypes.includes(kind) ? kind : 'Produto',
    subtype,
    unit: item.unit || 'Unidade / Diária',
    price: item.price ?? '',
    cost: item.cost ?? '',
    status: item.status || 'Disponível',
    description: item.description || '',
    specsText: specsToText(item.specs),
  });
  const [errors, setErrors] = useState({});
  const set = (key) => (value) => setForm((old) => ({ ...old, [key]: value }));

  function submit(event) {
    event.preventDefault();
    const next = {};
    if (form.name.trim().length < 3) next['item-name'] = 'Informe o nome do item (mínimo 3 letras).';
    if (!form.unit.trim()) next['item-unit'] = 'Informe a unidade de cobrança.';
    if (!(Number(form.price) > 0)) next['item-price'] = 'Informe um valor maior que zero.';
    if (form.cost !== '' && Number(form.cost) < 0) next['item-cost'] = 'O custo não pode ser negativo.';
    setErrors(next);
    const first = Object.keys(next)[0];
    if (first) {
      document.getElementById(first)?.focus();
      return;
    }
    onSave({
      ...item,
      name: form.name.trim(),
      version: form.version.trim(),
      category: form.category,
      type: form.subtype.trim() ? `${form.kind} / ${form.subtype.trim()}` : form.kind,
      unit: form.unit.trim(),
      price: Number(form.price),
      cost: form.cost === '' ? 0 : Number(form.cost),
      status: form.status,
      description: form.description.trim(),
      specs: textToSpecs(form.specsText),
    });
  }

  return (
    <Modal title={item.id ? 'Editar item' : 'Novo item do catálogo'} onClose={onClose}>
      <form noValidate onSubmit={submit} className="sp-form">
        <FormInput label="Nome do item" name="item-name" required value={form.name} error={errors['item-name']} onChange={set('name')} />
        <FormInput label="Versão / variação" name="item-version" value={form.version} onChange={set('version')} />
        <div className="sp-form-grid">
          <FormSelect label="Categoria" name="item-category" options={supplierCategories} value={form.category} onChange={set('category')} />
          <FormSelect label="Tipo" name="item-kind" options={inventoryTypes} value={form.kind} onChange={set('kind')} />
          <FormInput label="Subtipo" name="item-subtype" placeholder="Ex.: Estrutura, Mão de obra" value={form.subtype} onChange={set('subtype')} />
          <FormInput label="Unidade" name="item-unit" required value={form.unit} error={errors['item-unit']} onChange={set('unit')} />
          <FormInput
            label="Valor de referência (R$)"
            name="item-price"
            type="number"
            min="0.01"
            step="0.01"
            required
            value={form.price}
            error={errors['item-price']}
            onChange={set('price')}
          />
          <FormInput
            label="Custo direto (R$)"
            name="item-cost"
            type="number"
            min="0"
            step="0.01"
            hint="Usado para calcular a margem líquida."
            value={form.cost}
            error={errors['item-cost']}
            onChange={set('cost')}
          />
          <FormSelect label="Status" name="item-status" options={inventoryStatuses} value={form.status} onChange={set('status')} />
        </div>
        <FormTextArea label="Descrição técnica" name="item-description" rows={3} value={form.description} onChange={set('description')} />
        <FormTextArea
          label="Especificações (uma por linha)"
          name="item-specs"
          rows={4}
          hint="Formato: Rótulo: valor — ex.: Dimensões: 4,00 m x 2,20 m"
          value={form.specsText}
          onChange={set('specsText')}
        />
        <button className="button blue-button full">Salvar item</button>
      </form>
    </Modal>
  );
}
</file>

<file path="src/components/supplier/OpportunityCard.jsx">
import React from 'react';
import { Link } from 'react-router';
import { dateLabel, money } from '../UI';
import { toRoman } from '../../utils/format';
import { Callout, DateBox, InfoList, InfoRow, StatusPill, TagList } from './common';

const STATUS_TONES = {
  'Cotação aberta': 'green',
  'Em análise': 'blue',
  'Alta prioridade': 'purple',
};

/* Card de oportunidade (home do fornecedor). Recebe um item de supplierOpportunities. */
export default function OpportunityCard({ event, index }) {
  const submitted = !!event.proposal;
  const titleId = `opp-${event.id}`;
  return (
    <article className="sp-card sp-opportunity" aria-labelledby={titleId}>
      <header className="sp-opportunity-head">
        <span className="sp-index">EVENTO {toRoman(index + 1)}</span>
        <StatusPill tone={STATUS_TONES[event.status] || 'blue'}>{event.status}</StatusPill>
      </header>
      <h3 className="sp-card-title" id={titleId}>
        {event.title}
      </h3>
      <p className="sp-card-subtitle">{event.subtitle}</p>

      <DateBox date={dateLabel(event.date)} place={event.location} />

      <InfoList>
        <InfoRow label={`${event.requesterLabel || 'Organizador solicitante'}:`}>{event.organizer}</InfoRow>
        <InfoRow label="Serviços solicitados:">
          <TagList items={event.services || [event.category]} />
        </InfoRow>
        {submitted ? (
          <InfoRow label="Valor ofertado:">{money(event.proposal.value)}</InfoRow>
        ) : (
          event.deadline && (
            <InfoRow label={`${event.deadline.label}:`} tone={event.deadline.tone}>
              {event.deadline.value}
            </InfoRow>
          )
        )}
      </InfoList>

      {submitted && (
        <Callout
          icon="check"
          title={`Proposta submetida em ${event.proposal.sentAt}`}
          action={<span className="sp-protocol">Protocolo {event.proposal.protocol}</span>}
        />
      )}
      {event.highlight && (
        <Callout
          tone="purple"
          icon="star"
          title={event.highlight}
          action={
            <Link className="sp-callout-link" to={`/fornecedor/cotacao/${event.id}`}>
              Ver edital
            </Link>
          }
        />
      )}

      <Link
        className="button dark full sp-cta"
        to={submitted ? '/fornecedor/propostas' : `/fornecedor/cotacao/${event.id}`}
      >
        {submitted ? 'Acompanhar proposta' : 'Ver detalhes & cotar'}
      </Link>
    </article>
  );
}
</file>

