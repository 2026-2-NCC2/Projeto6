/* ===== Supplier directory styles ===== */
Diretório de fornecedores: interface compacta e orientada à tarefa */
.supplier-directory .page-title { margin-bottom: 22px; }
.supplier-toolbar {
  display: grid;
  grid-template-columns: minmax(240px, 1.5fr) minmax(190px, 1fr) minmax(155px, .7fr) auto;
  gap: 10px;
  align-items: center;
  padding: 14px;
  margin-bottom: 10px;
  background: #fff;
  border: 1px solid var(--line, #e1e8f0);
  border-radius: 14px;
}
.supplier-search {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  height: 42px;
  padding: 0 12px;
  color: #8292aa;
  border: 1px solid var(--line, #d7e0ec);
  border-radius: 9px;
  background: #fff;
}
.supplier-search > span[aria-hidden="true"] { font-size: 22px; line-height: 1; }
.supplier-search input {
  width: 100%; min-width: 0; height: 100%; padding: 0; border: 0; outline: 0;
  color: var(--ink, #152238); background: transparent; box-shadow: none;
}
.supplier-search input:focus { outline: 0; box-shadow: none; }
.supplier-search input::placeholder { color: #94a3b8; }
.supplier-clear-search { border: 0; background: transparent; color: #64748b; font-size: 20px; cursor: pointer; }
.supplier-filter select {
  width: 100%; height: 42px; padding: 0 34px 0 12px; color: #34445e;
  border: 1px solid var(--line, #d7e0ec); border-radius: 9px; background-color: #fff;
}
.supplier-reset { padding: 8px 6px; border: 0; background: transparent; color: var(--blue, #245cf5); white-space: nowrap; cursor: pointer; font-weight: 600; }
.supplier-results-line {
  display: flex; justify-content: space-between; align-items: center; gap: 12px;
  margin: 12px 2px 14px; color: #64748b; font-size: 12px;
}
.supplier-results-line strong { color: #26364f; }
.supplier-results-hint { text-align: right; }
.supplier-table-card { overflow: hidden; background: #fff; border: 1px solid var(--line, #e1e8f0); border-radius: 14px; box-shadow: 0 1px 2px rgba(15, 23, 42, .025); }
.supplier-table-scroll { width: 100%; overflow-x: auto; }
.supplier-table { width: 100%; border-collapse: collapse; text-align: left; }
.supplier-table thead { background: #f8fafc; }
.supplier-table th {
  padding: 13px 16px; color: #64748b; font-size: 10px; font-weight: 750;
  letter-spacing: .055em; text-transform: uppercase; white-space: nowrap;
  border-bottom: 1px solid var(--line, #e5ebf3);
}
.supplier-table td { padding: 13px 16px; border-bottom: 1px solid #edf1f6; color: #34445e; font-size: 12px; vertical-align: middle; }
.supplier-table tbody tr:last-child td { border-bottom: 0; }
.supplier-table tbody tr:hover { background: #fbfdff; }
.supplier-name-cell { display: flex; align-items: center; gap: 11px; min-width: 220px; }
.supplier-initials {
  display: inline-flex; align-items: center; justify-content: center; flex: 0 0 38px;
  width: 38px; height: 38px; border-radius: 11px; color: #245cf5; background: #edf4ff;
  border: 1px solid #d8e6ff; font-size: 11px; font-weight: 800;
}
.supplier-name-copy { display: flex; flex-direction: column; gap: 4px; }
.supplier-name-copy strong { color: #17243a; font-size: 12px; font-weight: 700; }
.supplier-name-copy small { color: #94a3b8; font-size: 10px; }
.supplier-category { display: inline-block; max-width: 190px; padding: 5px 8px; border-radius: 7px; background: #f1f5f9; color: #52627a; line-height: 1.35; }
.supplier-price { color: #1e2c42; font-size: 12px; white-space: nowrap; }
.supplier-status { display: inline-flex; align-items: center; gap: 7px; padding: 6px 9px; border-radius: 999px; font-size: 10px; font-weight: 650; white-space: nowrap; }
.supplier-status > span { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.supplier-status.is-confirmed { color: #087c50; background: #edfcf4; border: 1px solid #c8f3db; }
.supplier-status.is-pending { color: #986300; background: #fff9e9; border: 1px solid #f9e5a7; }
.supplier-row-actions { display: flex; align-items: center; justify-content: flex-end; gap: 7px; white-space: nowrap; }
.supplier-row-actions .button { min-height: 32px; padding: 6px 10px; font-size: 11px; }
.supplier-link-button { box-shadow: none; }
.supplier-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 245px; padding: 28px; text-align: center; }
.supplier-empty-icon { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 12px; border-radius: 50%; background: #f1f5f9; color: #64748b; font-size: 25px; }
.supplier-empty strong { color: #1e293b; }
.supplier-empty p { margin: 7px 0 16px; color: #718096; font-size: 13px; }
.supplier-detail-modal { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 14px; }
.supplier-modal-initials { width: 48px; height: 48px; font-size: 13px; }
.supplier-detail-modal p { margin-top: 0; }
.supplier-modal-price { margin: 10px 0; color: #17243a; font-size: 21px; font-weight: 750; }
.supplier-modal-price span { color: #94a3b8; font-size: 11px; font-weight: 400; }
.supplier-modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
@media (max-width: 900px) {
  .supplier-toolbar { grid-template-columns: minmax(0, 1fr) minmax(160px, .7fr); }
  .supplier-reset { justify-self: start; }
  .supplier-table { min-width: 760px; }
}
@media (max-width: 560px) {
  .supplier-toolbar { grid-template-columns: minmax(0, 1fr); padding: 11px; }
  .supplier-results-line { align-items: flex-start; flex-direction: column; gap: 4px; }
  .supplier-results-hint { text-align: left; }
  .supplier-table th, .supplier-table td { padding: 11px 12px; }
}

/* ===== Consolidation screen styles ===== */
Minimalist event consolidation screen */
.consolidation-workspace { max-width: 1240px; }
