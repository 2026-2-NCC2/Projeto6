                      <p>{person.note || 'Sem observações.'}</p>
                      <button
                        type="button"
                        className="button outline"
                        onClick={() => {
                          update('people', (old) =>
                            old.map((p) => (p.id === person.id ? { ...p, status: 'Pendente' } : p)),
                          );
                          setStatus('Pendente');
                          select(person.id);
                        }}
                      >
