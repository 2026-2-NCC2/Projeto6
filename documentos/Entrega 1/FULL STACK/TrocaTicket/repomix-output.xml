<file path="src/workspace.css">
:root {
  --ink: #121b30;
  --muted: #657997;
  --line: #dde5f0;
  --surface: #f7f9fb;
  --blue: #2860ed;
  --green: #009c75;
  --purple: #5746ef;
}
body {
  color: var(--ink);
}
button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
  transform: none !important;
}
textarea {
  font: inherit;
  width: 100%;
  resize: vertical;
  min-height: 100px;
  border: 1px solid #cbd7e8;
  border-radius: 8px;
  padding: 12px;
  color: var(--ink);
}
textarea:focus-visible {
  outline: 3px solid #b8c9ff;
  outline-offset: 2px;
}
input,
select {
  min-width: 0;
}
input[type='checkbox'],
input[type='radio'] {
  width: 17px;
  height: 17px;
  accent-color: var(--blue);
  flex-shrink: 0;
}
h1 {
  letter-spacing: -0.8px;
}
.app-shell {
  background: var(--surface);
  min-height: 100vh;
}
.app-shell main {
  min-height: calc(100vh - 195px);
}
.app-shell footer {
  background: white;
}
.app-header.header {
